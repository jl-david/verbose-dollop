{
  "name": "Multi-Platform Marketing Dashboard",
  "description": "Unified view of Google Ads, Meta Ads, GA4, LinkedIn Ads, and Twitter Ads",
  "pages": [
    {
      "id": "overview",
      "name": "Executive Overview",
      "components": [
        {
          "type": "scorecard",
          "id": "total_spend",
          "title": "Total Spend",
          "metric": "spend",
          "comparison": "previous_period",
          "position": { "row": 0, "col": 0, "width": 2, "height": 1 }
        },
        {
          "type": "scorecard",
          "id": "total_impressions",
          "title": "Total Impressions",
          "metric": "impressions",
          "comparison": "previous_period",
          "position": { "row": 0, "col": 2, "width": 2, "height": 1 }
        },
        {
          "type": "scorecard",
          "id": "total_clicks",
          "title": "Total Clicks",
          "metric": "clicks",
          "comparison": "previous_period",
          "position": { "row": 0, "col": 4, "width": 2, "height": 1 }
        },
        {
          "type": "scorecard",
          "id": "total_conversions",
          "title": "Total Conversions",
          "metric": "conversions",
          "comparison": "previous_period",
          "position": { "row": 0, "col": 6, "width": 2, "height": 1 }
        },
        {
          "type": "scorecard",
          "id": "overall_ctr",
          "title": "Overall CTR",
          "metric": "ctr",
          "position": { "row": 0, "col": 8, "width": 2, "height": 1 }
        },
        {
          "type": "scorecard",
          "id": "overall_roas",
          "title": "ROAS",
          "metric": "roas",
          "position": { "row": 0, "col": 10, "width": 2, "height": 1 }
        },
        {
          "type": "time_series",
          "id": "spend_over_time",
          "title": "Spend Over Time by Platform",
          "dimension": "date",
          "metrics": ["spend"],
          "breakdown_dimension": "platform",
          "position": { "row": 1, "col": 0, "width": 12, "height": 3 }
        },
        {
          "type": "pie_chart",
          "id": "spend_by_platform",
          "title": "Spend Share by Platform",
          "dimension": "platform",
          "metric": "spend",
          "position": { "row": 4, "col": 0, "width": 4, "height": 3 }
        },
        {
          "type": "bar_chart",
          "id": "conversions_by_platform",
          "title": "Conversions by Platform",
          "dimension": "platform",
          "metrics": ["conversions"],
          "position": { "row": 4, "col": 4, "width": 4, "height": 3 }
        },
        {
          "type": "scatter_chart",
          "id": "ctr_vs_cpa",
          "title": "CTR vs CPA by Campaign",
          "x_metric": "ctr",
          "y_metric": "cpa",
          "size_metric": "spend",
          "dimension": "campaign_name",
          "position": { "row": 4, "col": 8, "width": 4, "height": 3 }
        }
      ],
      "filters": [
        { "field": "platform", "type": "multi_select" },
        { "field": "date",     "type": "date_range" }
      ]
    },
    {
      "id": "google_ads",
      "name": "Google Ads",
      "data_source": "google_ads_performance",
      "components": [
        {
          "type": "scorecard_row",
          "metrics": ["impressions", "clicks", "spend", "conversions", "ctr", "cpc", "cpa", "roas"],
          "position": { "row": 0, "col": 0, "width": 12, "height": 1 }
        },
        {
          "type": "time_series",
          "id": "gads_spend_clicks",
          "title": "Spend & Clicks Over Time",
          "dimension": "date",
          "metrics": ["spend", "clicks"],
          "dual_axis": true,
          "position": { "row": 1, "col": 0, "width": 8, "height": 3 }
        },
        {
          "type": "pie_chart",
          "id": "gads_network_breakdown",
          "title": "Impressions by Network",
          "dimension": "network_type",
          "metric": "impressions",
          "position": { "row": 1, "col": 8, "width": 4, "height": 3 }
        },
        {
          "type": "table",
          "id": "gads_campaign_table",
          "title": "Campaign Performance",
          "dimensions": ["campaign_name", "device"],
          "metrics": ["impressions", "clicks", "spend", "conversions", "ctr", "cpc", "cpa"],
          "sort_by": "spend",
          "sort_order": "desc",
          "position": { "row": 4, "col": 0, "width": 12, "height": 5 }
        }
      ],
      "filters": [
        { "field": "device",        "type": "multi_select" },
        { "field": "network_type",  "type": "multi_select" },
        { "field": "date",          "type": "date_range" }
      ]
    },
    {
      "id": "meta_ads",
      "name": "Meta Ads (Facebook & Instagram)",
      "data_source": "meta_ads_performance",
      "components": [
        {
          "type": "scorecard_row",
          "metrics": ["impressions", "reach", "clicks", "spend", "conversions", "ctr", "cpm", "cpa", "roas"],
          "position": { "row": 0, "col": 0, "width": 12, "height": 1 }
        },
        {
          "type": "time_series",
          "id": "meta_reach_frequency",
          "title": "Reach & Frequency Over Time",
          "dimension": "date",
          "metrics": ["reach", "frequency"],
          "dual_axis": true,
          "position": { "row": 1, "col": 0, "width": 6, "height": 3 }
        },
        {
          "type": "time_series",
          "id": "meta_spend_roas",
          "title": "Spend vs ROAS",
          "dimension": "date",
          "metrics": ["spend", "roas"],
          "dual_axis": true,
          "position": { "row": 1, "col": 6, "width": 6, "height": 3 }
        },
        {
          "type": "table",
          "id": "meta_adset_table",
          "title": "Ad Set Performance",
          "dimensions": ["campaign_name", "ad_group_name"],
          "metrics": ["impressions", "reach", "clicks", "spend", "conversions", "ctr", "cpm", "cpa"],
          "sort_by": "spend",
          "sort_order": "desc",
          "position": { "row": 4, "col": 0, "width": 12, "height": 5 }
        }
      ],
      "filters": [
        { "field": "date", "type": "date_range" }
      ]
    },
    {
      "id": "analytics",
      "name": "Google Analytics 4",
      "data_source": "ga4_performance",
      "components": [
        {
          "type": "scorecard_row",
          "metrics": ["sessions", "total_users", "new_users", "bounce_rate", "avg_session_duration", "pageviews", "conversions", "revenue"],
          "position": { "row": 0, "col": 0, "width": 12, "height": 1 }
        },
        {
          "type": "time_series",
          "id": "ga4_sessions",
          "title": "Sessions & Users Over Time",
          "dimension": "date",
          "metrics": ["sessions", "total_users"],
          "position": { "row": 1, "col": 0, "width": 8, "height": 3 }
        },
        {
          "type": "geo_map",
          "id": "ga4_geo",
          "title": "Sessions by Country",
          "dimension": "country",
          "metric": "sessions",
          "position": { "row": 1, "col": 8, "width": 4, "height": 3 }
        },
        {
          "type": "bar_chart",
          "id": "ga4_source_medium",
          "title": "Sessions by Source / Medium",
          "dimension": "source",
          "metrics": ["sessions", "conversions"],
          "position": { "row": 4, "col": 0, "width": 6, "height": 3 }
        },
        {
          "type": "table",
          "id": "ga4_campaign_table",
          "title": "Campaign Performance",
          "dimensions": ["campaign_name", "source", "medium", "device_category"],
          "metrics": ["sessions", "total_users", "bounce_rate", "avg_session_duration", "conversions", "revenue"],
          "sort_by": "sessions",
          "sort_order": "desc",
          "position": { "row": 4, "col": 6, "width": 6, "height": 3 }
        }
      ],
      "filters": [
        { "field": "source",          "type": "multi_select" },
        { "field": "medium",          "type": "multi_select" },
        { "field": "device_category", "type": "multi_select" },
        { "field": "country",         "type": "multi_select" },
        { "field": "date",            "type": "date_range" }
      ]
    },
    {
      "id": "linkedin_ads",
      "name": "LinkedIn Ads",
      "data_source": "linkedin_ads_performance",
      "components": [
        {
          "type": "scorecard_row",
          "metrics": ["impressions", "clicks", "spend", "leads", "conversions", "ctr", "cpc", "cpa"],
          "position": { "row": 0, "col": 0, "width": 12, "height": 1 }
        },
        {
          "type": "time_series",
          "id": "li_spend_leads",
          "title": "Spend & Leads Over Time",
          "dimension": "date",
          "metrics": ["spend", "leads"],
          "dual_axis": true,
          "position": { "row": 1, "col": 0, "width": 12, "height": 3 }
        },
        {
          "type": "table",
          "id": "li_campaign_table",
          "title": "Campaign Performance",
          "dimensions": ["campaign_name"],
          "metrics": ["impressions", "unique_impressions", "clicks", "spend", "leads", "conversions", "video_views", "ctr", "cpc", "cpa"],
          "sort_by": "spend",
          "sort_order": "desc",
          "position": { "row": 4, "col": 0, "width": 12, "height": 5 }
        }
      ],
      "filters": [
        { "field": "date", "type": "date_range" }
      ]
    },
    {
      "id": "twitter_ads",
      "name": "Twitter / X Ads",
      "data_source": "twitter_ads_performance",
      "components": [
        {
          "type": "scorecard_row",
          "metrics": ["impressions", "engagements", "clicks", "spend", "conversions", "video_views"],
          "position": { "row": 0, "col": 0, "width": 12, "height": 1 }
        },
        {
          "type": "time_series",
          "id": "tw_engagements",
          "title": "Engagements Over Time",
          "dimension": "date",
          "metrics": ["impressions", "engagements", "clicks"],
          "position": { "row": 1, "col": 0, "width": 8, "height": 3 }
        },
        {
          "type": "bar_chart",
          "id": "tw_social_actions",
          "title": "Social Actions by Campaign",
          "dimension": "campaign_name",
          "metrics": ["retweets", "likes", "replies"],
          "stacked": true,
          "position": { "row": 1, "col": 8, "width": 4, "height": 3 }
        },
        {
          "type": "table",
          "id": "tw_campaign_table",
          "title": "Campaign Performance",
          "dimensions": ["campaign_name"],
          "metrics": ["impressions", "engagements", "clicks", "spend", "conversions", "video_views", "retweets", "likes", "replies", "ctr", "cpc", "cpa"],
          "sort_by": "spend",
          "sort_order": "desc",
          "position": { "row": 4, "col": 0, "width": 12, "height": 5 }
        }
      ],
      "filters": [
        { "field": "date", "type": "date_range" }
      ]
    }
  ],
  "default_date_range": "LAST_30_DAYS",
  "theme": {
    "primary_color": "#4285F4",
    "platform_colors": {
      "google_ads":        "#4285F4",
      "meta_ads":          "#1877F2",
      "google_analytics":  "#E37400",
      "linkedin_ads":      "#0A66C2",
      "twitter_ads":       "#1DA1F2"
    }
  }
}
